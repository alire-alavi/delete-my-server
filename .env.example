# Copy to .env (never commit .env). Bun loads it automatically.

# YottaSrc console credentials
YOTTA_EMAIL=you@example.com
YOTTA_PASSWORD=change-me

# Telegram: create a bot with @BotFather, then message it once.
# If TELEGRAM_CHAT_ID is wrong, the bot replies with your real chat id.
TELEGRAM_BOT_TOKEN=123456:ABC-your-token
TELEGRAM_CHAT_ID=123456789

# Weekly run: at WEEKLY_DAY WEEKLY_TIME (in TZ) a Cancel message is sent for each server,
# and each one is deleted GRACE_MINUTES later unless cancelled.
# Servers: comma-separated YottaSrc console URLs (most reliable) or exact names.
WEEKLY_SERVERS=https://console.yottasrc.com/your-server-page
WEEKLY_DAY=friday
WEEKLY_TIME=18:00
TZ=Europe/Berlin
# If the container was down at the trigger time, still start the run when at most this many minutes late.
WEEKLY_MISSED_WINDOW_MINUTES=60

# Password for the one-time VNC login (`sudo -u deleteguard ./deploy/login.sh`)
VNC_PASSWORD=change-me-too

# Minutes between the Cancel message and deletion (the window to press Cancel)
GRACE_MINUTES=30
# Extra reminder this many minutes before deletion (0 disables)
REMINDER_MINUTES=5
# Minimum cancel window after a restart or a late announcement
RESTART_GRACE_MINUTES=5

# Safety switch: true walks the whole flow but never clicks the final confirm.
# Set to false only after `bun run dry-run <server>` looks right.
DRY_RUN=true

# Cloudflare Turnstile usually blocks headless Chrome. Keep false; the systemd service runs Chrome under xvfb-run.
HEADLESS=false
# chrome (Google Chrome, amd64) or chromium (Playwright's build; needed on arm64)
BROWSER_CHANNEL=chrome

# Optional overrides if the default heuristics don't find YottaSrc's buttons
# YOTTA_SERVERS_URL=https://console.yottasrc.com/
# YOTTA_DELETE_SELECTOR=button.btn-danger:has-text("Delete")
# YOTTA_CONFIRM_SELECTOR=.swal2-confirm
